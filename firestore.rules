rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /stats/global {
      allow read, write: if true;
    }

    match /exams/{examId} {
      // Anyone (including students) can read exams
      allow read: if true;
      
      // Any authenticated user (teachers, admins) can create, update, and delete exams
      allow create, update, delete: if isAuthenticated();
    }

    match /results/{resultId} {
      // Students can submit exam results and view history
      allow create: if request.resource.data.studentName is string &&
                   request.resource.data.examId is string;
      allow read, list: if true;
      allow delete, update: if isAuthenticated();
    }

    match /folders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /studentAccounts/{studentAccId} {
      allow read, list: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'mustChangePassword']) &&
        request.resource.data.password is string &&
        request.resource.data.password.size() >= 4 &&
        request.resource.data.mustChangePassword is bool
      );
    }
  }
}
