rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /stats/global {
      allow read, write: if true;
    }

    match /exams/{examId} {
      // Anyone (including students) can read exams
      allow read: if true;
      
      // Any authenticated user (teachers, admins) can create, update, and delete exams
      allow create, update, delete: if isAuthenticated();
    }

    match /results/{resultId} {
      // Students can submit exam results without logging in
      allow create: if request.resource.data.studentName is string &&
                   request.resource.data.examId is string;
      
      // Authenticated teachers/admins can read and delete results
      allow read, delete: if isAuthenticated();
      allow update: if isAuthenticated();
    }
  }
}
